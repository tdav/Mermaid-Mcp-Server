<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FoggyBalrog.MermaidDotNet" Version="0.20.0" />
    <PackageReference Include="Mermaider" Version="0.8.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0-preview.1" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\lib\mermaid.min.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
